{
  "name": "gimbap-hell",
  "version": "1.0.0",
  "description": "김밥지옥 — 3D 1인칭 멀티플레이 김밥 웨이브 디펜스 (three.js + Socket.IO)",
  "type": "commonjs",
  "private": true,
  "main": "apps/server/dist/main.js",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "start": "node apps/server/dist/main.js",
    "dev": "npm run dev --workspace=@repo/client",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "assets:hand": "node tools/generate-fps-hand-asset.mjs",
    "assets:food": "node tools/generate-low-poly-food-assets.mjs"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "license": "MIT",
  "devDependencies": {
    "@repo/eslint-config": "*",
    "@repo/typescript-config": "*",
    "eslint": "10.9.1",
    "prettier": "3.9.6",
    "turbo": "^2.10.12",
    "typescript": "^6.0.2"
  },
  "packageManager": "npm@11.19.0",
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
