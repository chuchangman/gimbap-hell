# 의존성
node_modules/

# 런타임에 생기는 데이터 (서버가 없으면 알아서 만든다)
data/

# 로컬 환경
.env
.env.*
*.log
npm-debug.log*

# OS
.DS_Store
Thumbs.db
desktop.ini

# 에셋 원본(.blend/.fbx/.obj)과 manifest 가 안 쓰는 팩. 여기서 뽑아낸
# apps/client/public/assets/**.glb 만 저장소에 들어간다 — 용량 문제도 있고
# 팩마다 재배포 허용 여부가 다르다. tools/ 의 생성기가 이 경로를 입력으로 읽는다.
assets-src/
__pycache__/

# 워크스페이스 빌드 산출물
dist/
.turbo/
*.tsbuildinfo
