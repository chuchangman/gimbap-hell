# 의존성
node_modules/

# 런타임에 생기는 데이터 (서버가 없으면 알아서 만든다)
data/

# 로컬 환경
.env
.env.*
*.log
npm-debug.log*

# OS
.DS_Store
Thumbs.db
desktop.ini

# 외부 에셋 팩 원본 (49MB · .blend/.fbx/.rar)
# 게임이 쓰는 건 여기서 뽑아낸 public/assets/**.glb 다. 원본까지 공개
# 저장소에 재배포하면 용량도 문제고, 팩마다 재배포 허용 여부가 다르다.
assets-src/

# 에셋 미리보기 스냅샷 (작업용 산출물)
/food-*-preview.png
/clay-*-preview.png
/clay-knife-closeup.png
/artifacts/
__pycache__/

# Runtime manifest 에서 쓰지 않는 원본 팩·승인용 시안은 assets-src/ 에 둔다.
# apps/client/public/ 아래에 두면 Vite 가 dist 로 복사해 배포까지 실려 나간다.
# (실제로 그렇게 13.7MB 가 나가고 있었다.)

# 워크스페이스 빌드 산출물
dist/
.turbo/
*.tsbuildinfo
